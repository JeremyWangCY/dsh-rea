    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.5-rc.3",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.3",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.3 || ^0.2.0-rc.2",
